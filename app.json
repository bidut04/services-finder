{
  "expo": {
    "name": "HelpNear",
    "slug": "helpnear",
    "scheme": "helpnear",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "HelpNear needs your location to find nearby home services and emergency roadside assistance."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#006A4E",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HelpNear needs your location to find nearby home services and roadside assistance."
        }
      ],
      "expo-font"
    ]
  }
}
